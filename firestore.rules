rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A score must be 3 capital letters and a sensible number.
    function validScore() {
      return request.resource.data.keys().hasOnly(['name', 'score', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z]{3}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5000
        && request.resource.data.createdAt == request.time;
    }
    // Only the owner's Google account can read stats and errors.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'barrettpreston236@gmail.com';
    }
    // One leaderboard per mode. Anyone can see them and add a score.
    match /scores_easy/{id} {
      allow read: if true;
      allow create: if validScore();
    }
    match /scores_medium/{id} {
      allow read: if true;
      allow create: if validScore();
    }
    match /scores_easy_snakes/{id} {
      allow read: if true;
      allow create: if validScore();
    }
    match /scores_medium_snakes/{id} {
      allow read: if true;
      allow create: if validScore();
    }
    // Usage counts: the game can add to them, only the owner can read them.
    match /stats/{day} {
      allow read: if isOwner();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visits', 'phone_visits', 'computer_visits', 'games', 'rooms',
             'games_easy', 'games_easy_snakes', 'games_medium', 'games_medium_snakes', 'games_twoplayer', 'games_online']);
    }
    // Dress-up play counts (from dressup.datasolutions365.com), one record per day.
    match /dressup_stats/{day} {
      allow read: if isOwner();
      allow create, update: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visits', 'phone_visits', 'computer_visits', 'start_playing', 'surprise',
             'save_look', 'open_gallery', 'open_music', 'open_messages', 'send_message']);
    }
    // Errors from the dress-up game: the game can add them, only the owner can read them.
    match /dressup_errors/{id} {
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['message', 'stack', 'where', 'version', 'device', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.where is string && request.resource.data.where.size() <= 200
        && request.resource.data.device is string && request.resource.data.device.size() <= 300
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.at == request.time;
    }
    // Errors from the game: the game can add them, only the owner can read them.
    match /errors/{id} {
      allow read: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['message', 'stack', 'where', 'version', 'device', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.where is string && request.resource.data.where.size() <= 200
        && request.resource.data.device is string && request.resource.data.device.size() <= 300
        && request.resource.data.version is int;
    }
  }
}
